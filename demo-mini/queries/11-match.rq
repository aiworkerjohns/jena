# FEATURE 6 — luc:match. One row per matched field per hit, joined to luc:query through
# ?hit. It answers "which field made this document match, and what does it hold" — only
# for fields declared idx:stored true.

PREFIX luc:  <urn:jena:lucene:index#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?label ?field ?value
WHERE {
    (?hit ?entity ?score) luc:query ("default" "default" "chocolate OR espresso" "" "" 10 0) .
    (?hit ?field ?value) luc:match () .
    ?entity rdfs:label ?label .
}
ORDER BY ?label ?field
